                "exec": [
                  "pm.test('200 or 202', () => pm.expect([200, 202]).to.include(pm.response.code));",
                  "const d = pm.response.json().data;",
                  "pm.test('status is a known value', () => pm.expect(['PENDING','REVIEW_REQUIRED','SUCCEEDED','FAILED']).to.include(d.status));",
                  "pm.test('202 only while unresolved', () => pm.expect(pm.response.code === 202).to.eql(['PENDING','REVIEW_REQUIRED'].includes(d.status)));",
