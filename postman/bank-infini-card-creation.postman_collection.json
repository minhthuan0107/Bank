          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('has items array', () => pm.expect(d.items).to.be.an('array'));",
                  "const id = pm.environment.get('card_id');",
                  "if (id) pm.test('new card is listed', () => pm.expect(d.items.map(c => String(c.id))).to.include(id));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Infini card detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/infini-cards/{{card_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "infini-cards",
                "{{card_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Reset request id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/wallet/card-creation-config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wallet",
                "card-creation-config"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Run before creating another card, so a new requestId is generated."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('request_id'); pm.environment.unset('card_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ready for a new card', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
